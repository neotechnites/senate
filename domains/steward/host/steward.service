[Unit]
Description=Steward — Ryan's household obligations manager (Telegram transport)
Documentation=https://github.com/ryan/senate/tree/master/domains/steward
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=steward
Group=steward
WorkingDirectory=/home/steward/steward
ExecStart=/usr/bin/python3 /home/steward/steward/daemon.py
Restart=always
RestartSec=10
Nice=10
MemoryMax=256M
CPUQuota=15%
StandardOutput=append:/home/steward/steward/logs/daemon.log
StandardError=append:/home/steward/steward/logs/daemon.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/steward/steward
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
