# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS / Editor files
.DS_Store
.vscode/
.idea/

# Environment and Secrets (CRITICAL: NEVER COMMIT KEYS)
.env
*.pem
*.key
nestor/secrets/
secrets/

# Database WAL / SHM temporary lockfiles (preserve main .db files if desired)
*.db-wal
*.db-shm
*.db-journal

# Rust build artifacts
target/
crates/*/target/

# Virtual environments
.venv/
venv/

# Regenerable API-response caches (Kalshi research). ~1.4 GB as of 2026-09-09.
# These are re-fetchable and must never enter git history.
domains/kalshi/data/research/*_cache/
domains/kalshi/data/research/*_cache_*/
domains/kalshi/data/research/autoseat_cache/
